{
  "manifest_version": 3,
  "name": "Instagram AI Spoiler Blocker",
  "version": "1.0.0",
  "description": "Intercepts Instagram reels/posts and blurs spoilers using AI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
